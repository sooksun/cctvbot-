# cctvbot production env — copy to .env.production and set REAL values.
#   cp .env.production.example .env.production
# .env.production is gitignored. NEVER commit real secrets.
#
# NOTE: ENVIRONMENT=production makes the API refuse to boot while any of
# API_SECRET_KEY / SYSTEM_API_TOKEN / ADMIN_PASSWORD is still its dev default.

ENVIRONMENT=production

# --- Database: EXTERNAL MariaDB on the host (do NOT bundle a db service) ---
# Create db + user first (see DEPLOY.md). host.docker.internal = the CasaOS host.
DATABASE_URL=mysql+pymysql://cctvbot:CHANGE_ME_DB_PASSWORD@host.docker.internal:3306/cctvbot

# --- API secrets (generate real values) ---
# API_SECRET_KEY:   openssl rand -base64 48
# SYSTEM_API_TOKEN: openssl rand -hex 32   (event-worker + API must match)
API_SECRET_KEY=CHANGE_ME_openssl_rand_base64_48
SYSTEM_API_TOKEN=CHANGE_ME_openssl_rand_hex_32

# Seed admin (created on first boot) — change the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# CORS + public origin (NPM terminates TLS for this domain)
CORS_ORIGINS=https://cctvbot.cnppai.com

# Web: baked at docker build. Same-origin via NPM => the PUBLIC domain (not localhost).
# Dashboard calls https://cctvbot.cnppai.com/api/... which NPM routes to the api container.
NEXT_PUBLIC_API_URL=https://cctvbot.cnppai.com

# --- Host port mapping (99xx convention; confirm they are FREE on the host) ---
WEB_PORT=9930
API_PORT=9931

# --- LINE (optional; text-only after confirm) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# --- Frigate ---
# Shared RTSP password referenced as {FRIGATE_RTSP_PASSWORD} in frigate/config.yml
FRIGATE_RTSP_PASSWORD=CHANGE_ME_camera_rtsp_password
